#include <stdio.h>
#define TAM 5
#define MIN_CODE 1					
#define MAX_CODE 999999999

int main(void){
	int cod[TAM]; double pre[TAM];
	printf("Ingrese %d productos, se solicitara el codigo y el precio:\n\n", TAM);
	
	for(int i=0;i<TAM;i++){
		while(1){
			long x; int ok;
			printf("Ingrese el codigo de barras (%d-%d): ", MIN_CODE, MAX_CODE);
			ok = scanf("%ld",&x); while(getchar()!='\n' && !feof(stdin));
			if(!ok){ printf("Error. Debe ingresar un entero.\n"); continue; }
			if(x<MIN_CODE || x>MAX_CODE){ printf("Error. Fuera de rango.\n"); continue; }
			cod[i]=(int)x; break;
		}
		while(1){
			double p; int ok;
			printf("Ingrese el precio: ");
			ok = scanf("%lf",&p); while(getchar()!='\n' && !feof(stdin));
			if(!ok){ printf("Error. Debe ingresar un numero.\n"); continue; }
			if(p<0){ printf("Error. El precio no puede ser negativo.\n"); continue; }
			pre[i]=p; break;
		}
	}
	
	printf("\nCodigo         Precio\n");
	for(int i=0;i<TAM;i++) printf("%9d     %10.2f\n", cod[i], pre[i]);
	int iMax=0,iMin=0;
	for(int i=1;i<TAM;i++){ if(pre[i]>pre[iMax]) iMax=i; if(pre[i]<pre[iMin]) iMin=i; }
	printf("\nMas caro:   [%d] %.2f\n", cod[iMax], pre[iMax]);
	printf("Mas barato: [%d] %.2f\n", cod[iMin], pre[iMin]);
	return 0;
}
	
